---
const links = [
  { href: "/", label: "หน้าแรก" },
  { href: "/services/", label: "บริการ" },
  { href: "/about/", label: "เกี่ยวกับเรา" },
  { href: "/blog/", label: "บล็อก" },
  { href: "/contact/", label: "ติดต่อ" },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <nav class="container navbar" aria-label="เมนูหลัก">
    <a class="brand" href="/">
      FLOWORKS <small>/ ERPNext Thailand</small>
    </a>

    <input class="nav-toggle" type="checkbox" id="nav-toggle" aria-hidden="true" />
    <label class="hamburger" for="nav-toggle" aria-label="เปิด/ปิดเมนู">☰</label>

    <ul class="nav-links">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={path === l.href || (l.href !== "/" && path.startsWith(l.href)) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="nav-cta">
        <a class="btn btn--ghost" href="/contact/">ปรึกษาฟรี</a>
      </li>
    </ul>
  </nav>
</header>
