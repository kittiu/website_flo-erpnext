---
import Base from "../layouts/Base.astro";

const title = "ติดต่อเรา — Flo Works Limited | ERPNext Thailand";
const description =
  "ติดต่อ Flo Works Limited เพื่อปรึกษาการวางระบบ ERPNext ฟรี 30 นาที — sales@flo-works.co, +66 81 841 7480, สำนักงาน Silom Edge กรุงเทพฯ";
---

<Base title={title} description={description}>
  <section class="hero container">
    <p class="eyebrow">Contact</p>
    <h1>Talk to us for 30 minutes.<br />No sales pitch. No strings.</h1>
    <p class="lead" style="max-width: 60ch">
      บอกเราว่าธุรกิจคุณทำอะไร มีพนักงานกี่คน ใช้ระบบอะไรอยู่ และจุดที่ปวดหัวที่สุดตอนนี้คืออะไร
      เราจะช่วยประเมินคร่าว ๆ ว่า ERPNext เหมาะกับคุณไหม พร้อมประมาณการขอบเขตและค่าใช้จ่ายเบื้องต้น
    </p>
  </section>

  <section class="section container">
    <div class="grid grid-2" style="grid-template-columns: 1.2fr 1fr">
      <div>
        <form class="form-grid" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p style="display:none"><label>ห้ามกรอกช่องนี้ <input name="bot-field" /></label></p>

          <div class="form-field">
            <label for="name">ชื่อ / บริษัท</label>
            <input id="name" name="name" type="text" required placeholder="เช่น คุณสมชาย / บริษัท สมชาย จำกัด" />
          </div>

          <div class="form-field">
            <label for="email">อีเมล</label>
            <input id="email" name="email" type="email" required placeholder="you@company.co.th" />
          </div>

          <div class="form-field">
            <label for="phone">เบอร์โทร (ไม่บังคับ)</label>
            <input id="phone" name="phone" type="tel" placeholder="08x xxx xxxx" />
          </div>

          <div class="form-field">
            <label for="company_size">ขนาดบริษัท</label>
            <select id="company_size" name="company_size">
              <option value="">— เลือก —</option>
              <option value="1-20">1–20 คน</option>
              <option value="21-50">21–50 คน</option>
              <option value="51-100">51–100 คน</option>
              <option value="100+">100+ คน</option>
            </select>
          </div>

          <div class="form-field">
            <label for="message">เล่าปัญหาหรือความต้องการ</label>
            <textarea id="message" name="message" required placeholder="เช่น ตอนนี้ใช้ Excel + โปรแกรมบัญชีแยกกัน สต็อกไม่ตรง ยอดลูกหนี้ตามยาก อยากได้ระบบบัญชี-ขาย-สต็อกในที่เดียว"></textarea>
          </div>

          <div>
            <button class="btn btn--lg" type="submit">ส่งข้อความ</button>
          </div>
        </form>
        <p class="muted" style="font-size: 0.85rem; margin-top: 1rem">
          ฟอร์มนี้ทำงานเมื่อเว็บไซต์ถูก deploy บน Netlify — หรือส่งอีเมลตรงถึงเราได้ที่
          <a href="mailto:sales@flo-works.co">sales@flo-works.co</a>
        </p>
      </div>

      <div>
        <h2>Contact channels</h2>
        <div class="faq" style="margin-top: 0.5rem">
          <div style="border-bottom: 1px solid var(--line); padding: 1rem 0">
            <h3 style="margin: 0 0 0.3rem">Email</h3>
            <p class="muted" style="margin: 0">
              <a href="mailto:sales@flo-works.co">sales@flo-works.co</a>
            </p>
          </div>
          <div style="border-bottom: 1px solid var(--line); padding: 1rem 0">
            <h3 style="margin: 0 0 0.3rem">Phone</h3>
            <p class="muted" style="margin: 0">
              <a href="tel:+66818417480">+66 81 841 7480</a>
            </p>
          </div>
          <div style="border-bottom: 1px solid var(--line); padding: 1rem 0">
            <h3 style="margin: 0 0 0.3rem">Address</h3>
            <p class="muted" style="margin: 0">
              Flo Works Limited<br />
              2 Silom Edge Building, 10th Floor<br />
              Room S10063, Silom Road, Suriyawong,<br />
              Bangrak, Bangkok 10500
            </p>
          </div>
          <div style="padding: 1rem 0">
            <h3 style="margin: 0 0 0.3rem">Office hours</h3>
            <p class="muted" style="margin: 0">จันทร์–ศุกร์ 09:00–18:00 น. (เวลาประเทศไทย)</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
